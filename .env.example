# ========================================================
# AI Newsroom & Telegram Automation Configuration
# ========================================================

# Telegram Bot Credentials (Required)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_MODERATION_CHAT_ID=-100XXXXXXXXXX
TELEGRAM_CHANNEL_ID=@your_public_channel_name

# LLM Endpoint (Local LM Studio, Ollama, or OpenAI-compatible provider)
# For local LM Studio: http://host.docker.internal:1234/v1/chat/completions
# For local Ollama:     http://host.docker.internal:11434/v1/chat/completions
# For OpenAI:           https://api.openai.com/v1/chat/completions
LLM_API_URL=http://host.docker.internal:1234/v1/chat/completions
# Sent as "Authorization: Bearer ...". Local servers ignore it, cloud providers need a real key.
LLM_API_KEY=not-needed-for-local-models
# Overrides the model name hardcoded in the prompt nodes (gemma-4-e4b). Leave empty to keep it.
# e.g. gpt-4o-mini for OpenAI, qwen2.5:7b for Ollama
LLM_MODEL=

# n8n Network & Security Configuration
# By default, n8n binds to 127.0.0.1 for secure local access or reverse proxy setup.
# Change N8N_BIND_ADDR to 0.0.0.0 if you want to expose it on all interfaces.
N8N_BIND_ADDR=127.0.0.1
N8N_HOST_PORT=5678
# Set to true if n8n is served over HTTPS
N8N_SECURE_COOKIE=false

# n8n General Configuration
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Kyiv

# Execution Pruning & SQLite Database Retention
# 10-second polling produces ~260k execution records per month. Pruning prevents SQLite bloat.
# Maximum age of execution data to retain (in hours, 168h = 7 days)
EXECUTIONS_DATA_MAX_AGE=168
# Maximum number of execution records to retain in SQLite
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
