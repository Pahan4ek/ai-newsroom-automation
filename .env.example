# ========================================================
# AI Newsroom & Telegram Automation Configuration
# ========================================================

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_MODERATION_CHAT_ID=-100XXXXXXXXXX
TELEGRAM_CHANNEL_ID=@your_public_channel_name

# LLM Endpoint (Local LM Studio, Ollama, or OpenAI-compatible provider)
# For local LM Studio: http://host.docker.internal:1234/v1/chat/completions
# For local Ollama:     http://host.docker.internal:11434/v1/chat/completions
# For OpenAI:           https://api.openai.com/v1/chat/completions
LLM_API_URL=http://host.docker.internal:1234/v1/chat/completions
LLM_API_KEY=not-needed-for-local-models

# n8n General Configuration
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Kyiv
